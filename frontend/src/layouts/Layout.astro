---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Nexus Platform</title>
        
        {/* Theme Toggle Script - Runs before hydration to prevent flash */}
        <script is:inline>
            const theme = (() => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                return 'light'; // Default to light mode as requested
            })();
            
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
            window.localStorage.setItem('theme', theme);
        </script>
	</head>
	<body class="bg-grid-pattern min-h-screen flex flex-col">
        <nav class="editorial-border-b bg-[var(--bg-primary)] sticky top-0 z-50">
            <div class="max-w-screen-2xl mx-auto px-6 py-4 flex justify-between items-center">
                <a href="/" class="font-serif text-3xl font-black tracking-tight uppercase flex items-center gap-3">
                    <div class="w-5 h-5 bg-[var(--text-primary)]"></div>
                    NEXUS <span class="text-[var(--muted)] font-sans font-medium lowercase tracking-normal text-lg mt-1">platform</span>
                </a>
                
                <div class="flex items-center gap-6 text-xs font-bold uppercase tracking-widest">
                    <a href="/explain" class="hover:text-[var(--accent)] transition-colors hidden md:block">Explainability</a>
                    <a href="/data-quality" class="hover:text-[var(--accent)] transition-colors hidden md:block">Data Quality</a>
                    <a href="/architecture" class="hover:text-[var(--accent)] transition-colors hidden md:block">Architecture</a>
                    <a href="/forecast" class="hover:text-[var(--accent)] transition-colors hidden md:block">Forecast</a>
                    
                    <button id="themeToggle" class="w-10 h-10 rounded-full editorial-border flex items-center justify-center hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] transition-all cursor-pointer">
                        <svg class="w-4 h-4 hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
                        <svg class="w-4 h-4 block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
                    </button>
                </div>
            </div>
        </nav>

		<main class="flex-grow w-full relative">
            <slot />
        </main>

        <footer class="mt-16 editorial-border-t bg-[var(--card-bg)] pt-12 pb-8 px-6">
            <div class="max-w-screen-2xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                <div>
                    <h4 class="font-serif text-2xl font-black uppercase mb-4 text-[var(--text-primary)] flex items-center gap-2">
                        <div class="w-3 h-3 bg-[var(--text-primary)]"></div> 
                        NEXUS <span class="text-[var(--muted)] font-sans font-medium lowercase tracking-normal text-sm mt-1">v3</span>
                    </h4>
                    <p class="font-sans text-xs text-[var(--muted)] leading-relaxed max-w-sm">Enterprise Customer Intelligence Platform combining churn prediction, explainable AI, forecasting, NLP review intelligence, intervention recommendations, and data quality monitoring.</p>
                </div>
                <div class="md:col-span-2">
                    <h4 class="font-sans text-[10px] font-bold uppercase tracking-widest text-[var(--muted)] mb-4">Technology Stack</h4>
                    <div class="flex flex-wrap gap-2">
                        {['React', 'TypeScript', 'PostgreSQL', 'dbt', 'XGBoost', 'SHAP', 'Prophet', 'FastAPI'].map(tech => (
                            <span class="px-3 py-1 editorial-border bg-[var(--bg-primary)] text-[9px] font-bold uppercase tracking-widest text-[var(--text-primary)]">{tech}</span>
                        ))}
                    </div>
                </div>
            </div>
            <div class="max-w-screen-2xl mx-auto border-t border-[var(--border-primary)] pt-6 flex flex-col md:flex-row justify-between items-center text-[10px] text-[var(--muted)] font-bold uppercase tracking-widest gap-4">
                <span>&copy; {new Date().getFullYear()} Nexus Enterprise &mdash; Built with React, FastAPI, PostgreSQL, dbt, XGBoost, SHAP, Prophet and NLP.</span>
                <span>Confidential Internal System</span>
            </div>
        </footer>

        <script>
            const setupThemeToggle = () => {
                const themeToggle = document.getElementById('themeToggle');
                const handleToggleClick = () => {
                    const element = document.documentElement;
                    element.classList.toggle('dark');
                    const isDark = element.classList.contains('dark');
                    localStorage.setItem('theme', isDark ? 'dark' : 'light');
                    
                    // Dispatch event for React components (like Recharts) to re-render
                    window.dispatchEvent(new Event('themechange'));
                };
                
                themeToggle?.addEventListener('click', handleToggleClick);
            };

            // Run on initial load
            setupThemeToggle();
            
            // Re-run if Astro uses ViewTransitions
            document.addEventListener('astro:page-load', setupThemeToggle);
        </script>
	</body>
</html>